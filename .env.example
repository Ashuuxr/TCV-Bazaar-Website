# Public browser variables (set for Development, Preview, and Production)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only variables (never prefix with VITE_ and never expose to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Do not set VITE_SUPABASE_SERVICE_ROLE_KEY.
# Do not commit a real .env file or any secret key.
